<?xml version="1.0" encoding="utf-8"?>
<!-- The 3D view is added in code at index 0; everything here is drawn on top of it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vignette" />

    <!-- Swipes and taps while playing -->
    <View
        android:id="@+id/touch_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- ============================== HUD ============================== -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingTop="14dp"
        android:paddingEnd="28dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/hearts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_marginEnd="2dp" android:src="@drawable/ic_heart" android:contentDescription="@null" />
                <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_marginEnd="2dp" android:src="@drawable/ic_heart" android:contentDescription="@null" />
                <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_heart" android:contentDescription="@null" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/shield_track"
                android:layout_width="94dp"
                android:layout_height="7dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_progress_track"
                android:visibility="invisible">

                <View
                    android:id="@+id/shield_fill"
                    android:layout_width="94dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_shield" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/progress_track"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_weight="1"
            android:background="@drawable/bg_progress_track">

            <View
                android:id="@+id/progress_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_progress_fill" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:src="@drawable/redbob" />

            <TextView
                android:id="@+id/bobs"
                style="@style/GameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minWidth="28dp"
                android:textSize="19sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/score"
            style="@style/GameText"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:minWidth="92dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="19sp" />

        <ImageButton
            android:id="@+id/pause"
            style="@style/RoundButton"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/pause"
            android:src="@drawable/ic_pause" />
    </LinearLayout>

    <!-- Big centred messages: GO!, SHIELD!, HOME! -->
    <com.HaizStudio.ChakaZulu.ui.OutlineTextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="40dp"
        android:fontFamily="sans-serif-black"
        android:padding="12dp"
        android:textSize="64sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tutorial"
        style="@style/GameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:paddingStart="22dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp"
        android:text="@string/tutorial"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- ============================== MENU ============================== -->
    <FrameLayout
        android:id="@+id/menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="44dp"
            android:layout_marginBottom="30dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.HaizStudio.ChakaZulu.ui.OutlineTextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/title"
                android:textSize="54sp" />

            <TextView
                style="@style/GameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:layout_marginBottom="22dp"
                android:letterSpacing="0.4"
                android:text="@string/subtitle"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/level_prev"
                    style="@style/RoundButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="6dp"
                    android:contentDescription="@string/previous_level"
                    android:src="@drawable/ic_chevron_left" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/level"
                        style="@style/GameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:id="@+id/level_stars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_star_empty" android:contentDescription="@null" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_star_empty" android:contentDescription="@null" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_star_empty" android:contentDescription="@null" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/level_next"
                    style="@style/RoundButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="6dp"
                    android:contentDescription="@string/next_level"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <Button
                android:id="@+id/play"
                style="@style/GameButton"
                android:layout_width="wrap_content"
                android:layout_height="62dp"
                android:layout_marginTop="10dp"
                android:minWidth="210dp"
                android:text="@string/play"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/best"
                style="@style/GameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="18dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/music"
                style="@style/RoundButton"
                android:contentDescription="@string/music"
                android:src="@drawable/ic_music" />

            <ImageButton
                android:id="@+id/sound"
                style="@style/RoundButton"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/sound"
                android:src="@drawable/ic_volume" />
        </LinearLayout>

        <TextView
            style="@style/GameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="18dp"
            android:alpha="0.85"
            android:letterSpacing="0.3"
            android:text="@string/studio"
            android:textSize="11sp" />
    </FrameLayout>

    <!-- ============================== PAUSE ============================== -->
    <FrameLayout
        android:id="@+id/pause_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_dim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/pause_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="26dp">

            <TextView
                style="@style/PanelText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/paused"
                android:textSize="32sp" />

            <Button
                android:id="@+id/resume"
                style="@style/GameButton"
                android:layout_marginTop="18dp"
                android:drawableStart="@drawable/ic_play"
                android:minWidth="200dp"
                android:text="@string/resume" />

            <Button
                android:id="@+id/pause_home"
                style="@style/GameButton.Secondary"
                android:drawableStart="@drawable/ic_home"
                android:drawableTint="#FFB45F1A"
                android:layout_marginTop="12dp"
                android:minWidth="200dp"
                android:text="@string/home" />
        </LinearLayout>
    </FrameLayout>

    <!-- ============================== RESULT ============================== -->
    <FrameLayout
        android:id="@+id/result_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_dim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/result_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_panel"
            android:gravity="center_horizontal"
            android:minWidth="380dp"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="18dp"
            android:paddingEnd="30dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/result_title"
                style="@style/PanelText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="28sp" />

            <LinearLayout
                android:id="@+id/result_stars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <ImageView android:layout_width="52dp" android:layout_height="52dp" android:layout_marginTop="10dp" android:src="@drawable/ic_star_empty" android:contentDescription="@null" />
                <ImageView android:layout_width="64dp" android:layout_height="64dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:src="@drawable/ic_star_empty" android:contentDescription="@null" />
                <ImageView android:layout_width="52dp" android:layout_height="52dp" android:layout_marginTop="10dp" android:src="@drawable/ic_star_empty" android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/result_score"
                    style="@style/PanelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFE5690B"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/result_new_best"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_tag"
                    android:fontFamily="sans-serif-black"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:rotation="-6"
                    android:text="@string/new_best"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/result_detail"
                style="@style/PanelText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/result_home"
                    style="@style/GameButton.Secondary"
                    android:drawableStart="@drawable/ic_home"
                    android:drawableTint="#FFB45F1A"
                    android:minWidth="130dp"
                    android:text="@string/home" />

                <Button
                    android:id="@+id/result_again"
                    style="@style/GameButton.Secondary"
                    android:drawableStart="@drawable/ic_replay"
                    android:drawableTint="#FFB45F1A"
                    android:layout_marginStart="10dp"
                    android:minWidth="130dp"
                    android:text="@string/again" />

                <Button
                    android:id="@+id/result_next"
                    style="@style/GameButton"
                    android:drawableEnd="@drawable/ic_play"
                    android:layout_marginStart="10dp"
                    android:minWidth="150dp"
                    android:text="@string/next" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</FrameLayout>
